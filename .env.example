# Только отдельный тестовый стенд. Секреты не публиковать.
# Изменения требуют перезапуска API/worker/bot. Пустые интеграции отключены.
# Списки и словари — JSON; ID Telegram/Remnawave хранятся строками.
# Настройка instance_config_path; по умолчанию интеграция отключена, требуется перезапуск.
INSTANCE_CONFIG_PATH='config/instance.json'
# Настройка app_name; по умолчанию интеграция отключена, требуется перезапуск.
APP_NAME='VLESS VPN Shop'
# Настройка app_short_name; по умолчанию интеграция отключена, требуется перезапуск.
APP_SHORT_NAME=''
# Настройка app_slug; по умолчанию интеграция отключена, требуется перезапуск.
APP_SLUG='vpn-shop'
# Настройка app_description; по умолчанию интеграция отключена, требуется перезапуск.
APP_DESCRIPTION='Подписки VPN и управление подключением.'
# Настройка visual_profile; по умолчанию интеграция отключена, требуется перезапуск.
