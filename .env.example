SUNRISE_OWNER_EMAIL=''
# Настройка owner_id; по умолчанию интеграция отключена, требуется перезапуск.
SUNRISE_OWNER_ID=''
# Согласованный тестовый домен лендинга. Запись не публикует сайт и не меняет DNS.
SUNRISE_LANDING_TEST_DOMAIN=''
# Согласованный тестовый домен личного кабинета. Запись не публикует сайт и не меняет DNS.
SUNRISE_DASHBOARD_TEST_DOMAIN=''
# Каноническая ссылка на оферту. Только начальное заполнение БД; далее менять через админку.
OFFER_URL=''
# Каноническая ссылка на политику. Только начальное заполнение БД; далее менять через админку.
PRIVACY_URL=''
# Версия оферты, подтверждённая владельцем: v1. Новая версия требует нового согласия.
OFFER_VERSION=''
# Версия политики, подтверждённая владельцем: v1. Это ID, а не дата публикации.
PRIVACY_VERSION=''
# Публичный site key отдельного TEST Turnstile для согласованного hostname.
SUNRISE_TURNSTILE_SITE_KEY=''
# Секрет: server-side secret отдельного TEST Turnstile; не вставлять в frontend.
SUNRISE_TURNSTILE_SECRET=''
# Точный hostname, для которого выпущены TEST Turnstile ключи.
SUNRISE_TURNSTILE_HOSTNAME=''
# Настройка turnstile_test_bypass; по умолчанию интеграция отключена, требуется перезапуск.
SUNRISE_TURNSTILE_TEST_BYPASS='false'
